{
  "name": "call-topic-insights",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
