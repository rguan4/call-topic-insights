# Copy to backend/.env and fill in. Never commit backend/.env.
PORT=4000

# AI Topic Insights. Leave OPENAI_API_KEY empty to use the built-in rule-based summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000

# Signs session tokens. Optional locally (a dev default is used); required when NODE_ENV=production.
# CTI_SESSION_SECRET=change-me

# Simulation knobs for demos and tests (optional)
# CTI_AI_DELAY_MS=700        delay per AI generation step
# CTI_AI_FAIL=1              force AI generation to fail
# CTI_TASK_TICK_MS=400       background task progress interval
# CTI_DISCOVERY_FAIL=1       make topic discovery fail (DSC-118)
# CTI_PREP_TICK_MS=1000      taxonomy preparation step interval
# CTI_PREP_FAIL=1            make v8 classifier validation fail (PRP-207)
# CTI_PERSIST=false          keep state in memory only
